---
// Links de contato: Instagram • Linkedin (linha de cima) Email (copia o email ao clicar) e WhatsApp, cada um com a seta nordeste
import { getEntry } from 'astro:content';
import { ArrowUpRight } from '@lucide/astro';
interface Props {
  class?: string;
  tx?: string;
  pressao?: boolean;
  pilulas?: boolean;
}
const { class: cls, tx = 'micro', pressao = true, pilulas = false } = Astro.props;
const semPressao = pressao ? undefined : '';
const s = (await getEntry('sobre', 'julia'))!.data;
---

<div class:list={['contato-links', pilulas && 'contato-links--pil', cls]}>
  <p class="contato-links__linha">
    <a class="contato-links__a contato-links__a--insta" style="--rot:-3deg" href={`https://www.instagram.com/${s.instagram}/`} target="_blank" rel="noopener"><span data-tx={tx} data-sem-pressao={semPressao}>Instagram</span><ArrowUpRight size={'1em'} strokeWidth={2.2} aria-hidden="true" /></a>
    <i class="contato-links__ponto" aria-hidden="true"></i>
    <a class="contato-links__a contato-links__a--linkedin" style="--rot:2.5deg;--atraso:80ms" href={`https://www.linkedin.com/in/${encodeURIComponent(s.linkedin)}/`} target="_blank" rel="noopener"><span data-tx={tx} data-sem-pressao={semPressao} data-tx-atraso="80" style="--atraso:80ms">Linkedin</span><ArrowUpRight size={'1em'} strokeWidth={2.2} aria-hidden="true" /></a>
  </p>
  <p class="contato-links__linha contato-links__linha--whats">
    <a class="contato-links__a contato-links__a--whats" style="--rot:-2.5deg;--atraso:40ms" href="https://wa.me/5551999395522" target="_blank" rel="noopener" data-tx-atraso="40"><span data-tx={tx} data-sem-pressao={semPressao} data-tx-atraso="40" style="--atraso:40ms">WhatsApp</span><ArrowUpRight size={'1em'} strokeWidth={2.2} aria-hidden="true" /></a>
  </p>
  <p class="contato-links__linha">
    <button type="button" class="contato-links__a contato-links__a--email" style="--rot:-2deg" data-copiar={s.email} aria-label="Copiar o email"><span data-tx={tx} data-sem-pressao={semPressao} data-tx-atraso="160" style="--atraso:160ms">Email</span><ArrowUpRight size={'1em'} strokeWidth={2.2} aria-hidden="true" /></button>
  </p>
</div>

<style is:global>
  .contato-links {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: var(--weight-medium);
    letter-spacing: -0.04em;
    line-height: 0.9;
  }
  .contato-links__linha {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
  }
  .contato-links__linha + .contato-links__linha {
    margin-top: 5px;
  }
  /* WhatsApp: só no mobile (no web os contatos são Instagram, Linkedin e email) */
  .contato-links .contato-links__linha--whats {
    display: none;
  }
  /* rodapé da galeria: texto + seta nordeste (Lucide) em todos os links */
  .contato-esf .contato-links__a {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
  }
  .contato-esf .contato-links__a svg {
    flex: none;
    width: 1em;
    height: 1em;
  }
  .contato-links a,
  .contato-links button {
    color: inherit;
    text-decoration: none;
  }
  /* sublinhado desenhado à parte: o text-decoration quebra nas letras individuais do Text Appear */
  .contato-links a,
  .contato-links button {
    position: relative;
    display: inline-block;
  }
  .contato-links a::after,
  .contato-links button::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.1em;
    height: max(1px, 0.05em);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.35s var(--ease-soft);
  }
  .contato-links a:hover::after,
  .contato-links button:hover::after {
    transform: scaleX(1);
  }
  .contato-links a:hover,
  .contato-links button:hover {
    opacity: 1;
  }
  .contato-links button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    cursor: var(--cursor-link);
  }
  .contato-links__ponto {
    flex: none;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
  }
</style>

<script>
  import { reescrever } from '../scripts/tipografia';
  // copiar o email em vez de abrir o programa de email
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copiar]')) {
    if (b.dataset.pronto) continue;
    b.dataset.pronto = '1';
    const rotulo = b.querySelector<HTMLElement>('[data-tx]');
    const texto = rotulo?.textContent?.trim() || 'Email';
    const troca = (t: string) => (rotulo ? reescrever(rotulo, t) : (b.textContent = t));
    let t = 0;
    b.addEventListener('click', async () => {
      const email = b.dataset.copiar ?? '';
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = email;
        document.body.append(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      troca('Email copiado!');
      clearTimeout(t);
      t = window.setTimeout(() => troca(texto), 1800);
    });
  }
</script>
