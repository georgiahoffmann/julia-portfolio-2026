---
// Cursor customizado: estrela que segue o ponteiro (scripts/cursor.ts).
---

<canvas class="cursor-rasto" data-anim="cursor-rasto" aria-hidden="true"></canvas>
<div class="cursor" data-anim="cursor" aria-hidden="true">
  <img class="cursor__star" src="/cursors/estrela.svg" alt="" />
  <!-- no viewport offwhite (GIF) o cursor é outro, mesma caixa e também em difference -->
  <img class="cursor__alt" src="/cursors/mouse-09-offwhite.svg" alt="" />
  <!-- nas seções do grid e do cavalo (web) o cursor é este, em difference -->
  <img class="cursor__escuro" src="/cursors/mouse-10.svg" alt="" />
</div>

<script>
  import '../scripts/cursor.ts';
</script>

<style>
  /* mobile: sem cursor customizado nem rasto de giz */
  @media (max-width: 767px) {
    .cursor,
    .cursor-rasto {
      display: none;
    }
  }
  /* rasto de giz (web, nas seções de sobre e contato): azul, por cima do conteúdo e abaixo do cursor */
  .cursor-rasto {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-cursor) - 1);
    width: 100vw;
    height: 100vh;
    pointer-events: none;
  }
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-cursor);
    width: var(--cursor-w);
    height: var(--cursor-h);
    pointer-events: none;
    mix-blend-mode: difference; /* continua visível sobre o off white da galeria e sobre o preto */
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-soft);
  }
  .cursor.is-visible {
    opacity: 1;
  }
  .cursor__alt {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  :global(body.cursor-offwhite) .cursor__star {
    display: none;
  }
  :global(body.cursor-offwhite) .cursor__alt {
    display: block;
  }
  .cursor__star {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 1; /* estrela com opacidade total, em difference (o contêiner .cursor) */
  }
  .cursor__escuro {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  :global(body.cursor-escuro) .cursor__star,
  :global(body.cursor-escuro) .cursor__alt {
    display: none;
  }
  :global(body.cursor-escuro) .cursor__escuro {
    display: block;
  }
  /* projetos: volta a estrela (mesmo com o cursor claro ligado) */
  :global(body.cursor-estrela) .cursor__alt {
    display: none;
  }
  :global(body.cursor-estrela) .cursor__star {
    display: block;
  }
</style>
