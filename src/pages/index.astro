---
// Home: experiência de entrada (scripts/experiencia.ts)
//  1. cards flutuam soltos ao redor da Juju, centralizada (fundo off white), sem tapá-la
//  2. ~800ms depois entram no computador dela
//  3. saem enfileirados na horizontal (80% da tela) num novo viewport; o fundo vira azul
//  4. a câmera dá um zoom e passa por cada card da fila, como num plano de filme
//  5. a fila explode num mundo em forma de esfera, feito de cards alinhados (arraste para girar)
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostTile from '../components/PostTile.astro';
import AvisoMobile from '../components/AvisoMobile.astro';
import ContatoLinks from '../components/ContatoLinks.astro';
import posMobile from '../data/coisas-mobile.json'; // posições das coisas no mobile (editadas em /?editar)
import gif from '../assets/marca/julia-pedo.gif';
import wordmarkPreto from '../assets/marca/wordmark-preto.png';
// fotos da seção "sobre mim" e coisas que saem da cabeça: src/content/sobre/julia.md (editáveis no Pages CMS)
const { fotos, coisas: img } = (await getEntry('sobre', 'julia'))!.data;

// coisas que saem da cabeça dela ao pairar no GIF: w = largura, dx/dy = destino a partir da cabeça, r = giro (unidade k, ver .estrela)
const coisas = [
  // posições escolhidas à mão (modo ?editar), em unidades k a partir da cabeça
  { id: 'coisas-09', src: img.esquerdaAlto, w: 27.54, dx: -40, dy: -9.3, r: -4, d: 0 },
  { id: 'noite-embacada', soDesktop: true, src: img.esquerdaLonge, w: 18, dx: -62.0, dy: 18, r: 3, d: 120 }, // mesma altura da coisas-09
  { id: 'coisas-11', soDesktop: true, src: img.esquerdaBaixo, w: 5.5, dx: -37.5, dy: 39.4, r: 14, d: 240 }, // coisas-14 no lugar da 11: mesma altura (21,8k), girada 14° p/ a direita,
  { id: 'coisas-10', soDesktop: true, src: img.direitaAlto, w: 22.95, dx: 35.5, dy: -14.6, r: 3, d: 60 },
  { id: 'coisas-13', src: img.direitaLonge, w: 20.25, dx: 54.1, dy: 5.3, r: 4, d: 180 }, // entre as duas, mais para fora
  { id: 'coisas-12', soDesktop: true, src: img.direitaBaixo, w: 23.9, dx: 38.5, dy: 29.8, r: -4, d: 300 },
];
import juju from '../assets/juju-vermelho.svg';
import { ArrowDown, ArrowUpRight, ChevronsRight, Globe, LayoutGrid } from '@lucide/astro';

// cards que existem só na galeria (web e mobile): não entram na esfera nem na fila
const soGaleria = ['black-spunky'];
const postsTodos = (await getCollection('posts'))
  // só imagens (sem pendentes) e sem o card horizontal (talheres), que não cabe na esfera (os de `soGaleria` não vão para a esfera, então podem ser horizontais)
  .filter((p) => p.data.tipo === 'imagem' && p.data.image && (soGaleria.includes(p.id) || p.data.desktop.w / p.data.desktop.h < 1.5))
  .sort((a, b) => a.data.ordem - b.data.ordem);
const ordemWeb = new Map(postsTodos.map((p, i) => [p.id, i]));
// no DOM os da esfera vêm primeiro e os só-galeria por último; a ordem da galeria web vem de `data-ordem-web`
const posts = [...postsTodos.filter((p) => !soGaleria.includes(p.id)), ...postsTodos.filter((p) => soGaleria.includes(p.id))];
// posts que ficam na esfera e no mobile, mas não aparecem na lista da galeria web (carrossel-07 repete as lâminas do carrossel-02)
const semListaWeb = ['carrossel-07-sfx'];
// quadro parado de cada GIF de capa (gerado por scripts/posters.mjs, com o id do projeto): só o projeto mais visível roda o GIF
const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/projetos-posters/*.webp', { eager: true });
const posterDe = (id: string) => Object.entries(posters).find(([k]) => k.split('/').pop()!.replace(/\.[^.]+$/, '') === id)?.[1].default;
const projetosLista = await Promise.all(
  (await getCollection('projetos'))
    .sort((a, b) => (a.data.ordem ?? Infinity) - (b.data.ordem ?? Infinity) || a.data.titulo.localeCompare(b.data.titulo))
    .map(async (p) => ({ ...p.data, id: p.id, Content: (await render(p)).Content, capa: p.data.imagem, poster: p.data.imagem?.format === 'gif' ? posterDe(p.id) : undefined })),
);
---

<Base canvas intro>
  <AvisoMobile />
  <div class="grao" style="--op-e: calc((1 - var(--grao-bg, 0)) * 0.28); --op-c: calc(var(--grao-bg, 0) * 0.28)"><i class="grao__c grao__c--escuro"></i><i class="grao__c grao__c--claro"></i></div>
  <div class="camera" data-camera>
    <div class="juju" aria-hidden="true">
      <Image class="juju__img" data-juju src={juju} alt="" loading="eager" />
    </div>
    <div class="esfera-mira">
      <div class="esfera" data-esfera>
        <!-- estrutura da esfera: meridianos e paralelos de 0,8px sob os cards (scripts/experiencia.ts) -->
        <svg class="esfera__linhas" data-linhas aria-hidden="true">
          <path data-linhas-tras class="esfera__tras" />
          <path data-linhas-frente class="esfera__frente" />
        </svg>
        {posts.map((post) => <PostTile post={post} nudge={0} semListaWeb={semListaWeb.includes(post.id)} soGaleria={soGaleria.includes(post.id)} ordemWeb={ordemWeb.get(post.id)} />)}
      </div>
    </div>
  </div>
  <!-- a estrela offwhite cresce com a rolagem até cobrir a tela; surge o GIF e, rolando mais, a sequência "sobre" -->
  <div class="estrela" data-estrela>
    <div class="estrela__mundo" data-mundo>
      <div class="estrela__campo"></div>
      <!-- vetor recortado no contorno da estrela: nítido em qualquer tamanho -->
      <svg class="estrela__forma" viewBox="19.38 82.31 225.45 230.41" preserveAspectRatio="xMidYMax meet">
        <path d="M236.95,160.3l-59.93,46.86c5,22.98,10.4,46.19,20.1,67.77,3.59,7.98,8.03,14.81,2.35,21.92-13.54,16.87-24.48-8.31-45.3-24.82l-29.23-23.19-57.13,50.91c-6.04,5.39-12,18.86-24.29,10.09-6.85-4.89.46-17.17,3.74-24.15l32.72-69.38-48.17-28.86c-4.57-2.75-12.36-5.75-12.43-11.19-.07-4.22,7.98-10.23,12.93-10.61l72.15-5.66,25.8-60.35,5.63-11.04c.77-3.43,3.69-5.97,7.16-6.26,3.55-.29,6.9,1.85,8.15,5.21l11.38,64.99,68.75-10.2c3.86-.58,11.6,1.03,13.01,4.36,2.08,4.86-2.87,10.04-7.4,13.59Z" />
      </svg>
      <!-- grão do offwhite: acima da estrela (que é opaca), abaixo do palco e dos textos -->
      <div class="grao grao--campo" style="--op-e: 0.28"><i class="grao__c grao__c--escuro"></i></div>
      <div class="palco">
        <img class="palco__gif" src={gif.src} width={gif.width} height={gif.height} alt="" />
        <Image class="palco__wordmark" src={wordmarkPreto} alt="Júlia Pedó" widths={[400, 800]} sizes="40vh" />
        {coisas.map((c) => <Image class:list={['coisa', c.soDesktop && 'coisa--so-desktop']} src={c.src} alt="" widths={[300, 600]} sizes="20vh" data-coisa={c.id} style={`--w:${c.w};--dx:${c.dx};--dy:${c.dy};--dxm:${posMobile[c.id as keyof typeof posMobile].dx};--dym:${posMobile[c.id as keyof typeof posMobile].dy};--r:${c.r}deg;--d:${c.d}ms`} />)}
        <div class="palco__alvo" data-alvo></div>
      </div>
      <p class="verso verso--topo" data-tx="gif" data-coisa="verso-topo" style={`--dxm:${posMobile['verso-topo'].dx};--dym:${posMobile['verso-topo'].dy}`}>Pelas ideias inacabadas</p>
      <p class="verso verso--base" data-tx="gif" data-tx-atraso="350" data-coisa="verso-base" style={`--atraso:350ms;--dxm:${posMobile['verso-base'].dx};--dym:${posMobile['verso-base'].dy}`}>e por quem<br />insiste nelas</p>
    <div class="sobre-pilha">
    <!-- seção da foto: offwhite, foto em full-bleed à esquerda (800px de altura), cantos que se endireitam ao entrar -->
    <section class="foto-seq" aria-label="Sobre mim">
      <div class="grao"><i class="grao__c grao__c--escuro"></i></div>
      <figure class="foto-seq__fig foto-seq__fig--a"><Image src={fotos.grande} alt={fotos.grandeAlt ?? ''} widths={[600, 1200]} sizes="30vw" loading="eager" /></figure>
      <div class="foto-seq__txt"><p class="foto-seq__texto" data-tx="foto">Comecei a trabalhar com design aos 15 e nunca consegui largar o vício</p></div>
      <div class="foto-seq__txt foto-seq__txt--topo"><p class="foto-seq__mini" data-tx="foto" data-tx-atraso="200" style="--atraso:200ms">Sou de Porto Alegre e estudo Design na PUCRS</p></div>
      <div class="foto-seq__txt foto-seq__txt--base"><p class="foto-seq__texto foto-seq__texto--m" data-tx="foto" data-tx-atraso="350" style="--atraso:350ms">Hoje sou Designer JR no Studio Pirá <br class="so-web" />e faço freelas, de social media a identidade visual <br class="so-web" />e capas de disco.</p></div>
      <figure class="foto-seq__fig foto-seq__fig--b"><Image src={fotos.topo} alt={fotos.topoAlt ?? ''} widths={[500, 1000]} sizes="25vw" loading="eager" /></figure>
      <figure class="foto-seq__fig foto-seq__fig--c"><Image src={fotos.centro} alt={fotos.centroAlt ?? ''} widths={[500, 1000]} sizes="25vw" loading="eager" /></figure>
    </section>
    <section class="sobre-seq" aria-label="Sobre">
      <div class="grao"><i class="grao__c grao__c--escuro"></i><i class="grao__c grao__c--claro"></i></div>
      <!-- cavalo em dither, de fundo, em difference (a espiral áurea está guardada em scripts/cavalo.ts: para reativar, acrescente <canvas class="cavalo__aurea" data-aurea>) -->
      <canvas class="cavalo__canvas" data-cavalo role="img" aria-label="Cavalo correndo"></canvas>
      <div class="hero">
        <div class="hero__texto">
        <p class="hero__trabalho" aria-hidden="true" data-tx="sobre" data-tx-atraso="320" style="--atraso:320ms">trabalho com</p>
        <div class="rotativa" data-rotativa tabindex="0">
          <span class="sr-only">trabalho com identidade visual, posts para redes, flyer de evento, desdobramentos gráficos</span>
          <span class="rotativa__itens" aria-hidden="true">
            <span class="rotativa__item is-ativa" data-tx="rot">Identidade Visual</span>
            <span class="rotativa__item" data-tx="rot">Posts para Redes</span>
            <span class="rotativa__item" data-tx="rot">Flyer de Evento</span>
            <span class="rotativa__item" data-tx="rot">Desdobramentos Gráficos</span>
          </span>
        </div>
        </div>
        <ul class="pilulas">
          <li class="pilula" style="--rot:-3deg"><span data-tx="sobre">5+ anos de atuação</span></li>
          <li class="pilula" style="--rot:2deg"><span data-tx="sobre" data-tx-atraso="80" style="--atraso:80ms">Porto Alegre</span></li>
          <li class="pilula" style="--rot:-2deg"><span data-tx="sobre" data-tx-atraso="160" style="--atraso:160ms">Designer Jr · Studio Pirá</span></li>
          <li class="pilula pilula--destaque" style="--rot:3deg"><span data-tx="sobre" data-tx-atraso="240" style="--atraso:240ms">Aberta a freelas</span></li>
        </ul>
      </div>
    </section>
    <section class="proj-seq" aria-label="Projetos selecionados">
      <div class="grao"><i class="grao__c grao__c--escuro" style="--op-e:0.28"></i></div>
      {projetosLista.map((pr) => (
        <article class="proj">
          <div class="proj__txt">
            <h3 class="proj__titulo" data-tx="proj">{pr.titulo}</h3>
            <p class="proj__legenda" data-tx="proj" data-tx-atraso="120" style="--atraso:120ms">{pr.subtitulo}</p>
            <div class="proj__desc" data-tx="proj" data-tx-atraso="200" style="--atraso:200ms"><pr.Content /></div>
            {pr.link && <a class="proj__behance" href={pr.link} target="_blank" rel="noopener"><span>Behance</span><ArrowUpRight size={'1em'} strokeWidth={2} aria-hidden="true" /></a>}
          </div>
          {(() => {
            const miolo = pr.capa ? (pr.capa.format === 'gif' ? <img src={pr.poster?.src ?? pr.capa.src} data-gif={pr.poster ? pr.capa.src : undefined} data-poster={pr.poster?.src} alt={pr.titulo} width={pr.capa.width} height={pr.capa.height} /> : <Image src={pr.capa} alt={pr.titulo} widths={[600, 1000, 1600]} sizes="55vw" />) : <span class="proj__pend">{pr.titulo}<small>capa pendente</small></span>;
            return pr.link ? <a class="proj__img" href={pr.link} target="_blank" rel="noopener" aria-label={`Ver o projeto ${pr.titulo}`}>{miolo}</a> : <div class="proj__img">{miolo}</div>;
          })()}
        </article>
      ))}
    </section>
    <section class="rod-seq" aria-label="Contato">
      <div class="grao"><i class="grao__c grao__c--escuro"></i></div>
      <h2 class="rod-seq__tit" data-tx="rod">Onde me <br class="so-mobile" />encontrar</h2>
      <Image class="rod-seq__juju" src={juju} alt="" widths={[600, 1200]} sizes="40vw" />
      <ContatoLinks class="rod-seq__contato" tx="rod" pilulas />
      <a class="rod-seq__credito" data-credito href="https://www.linkedin.com/in/georgialirahoffmann/" data-href-mobile="https://www.georgiahoffmann.com/" target="_blank" rel="noopener"><span data-tx="rod" data-tx-atraso="300" style="--atraso:300ms">Powered by Georgia Hoffmann</span><ArrowUpRight size={'1em'} strokeWidth={2.2} aria-hidden="true" /></a>
    </section>
    <!-- adesivo coisas-12: no mobile, arrastável por todas as seções do sobre (scripts/editar-coisas.ts); web: oculto -->
      <Image class="foto-seq__sticker" src={img.direitaBaixo} alt="" widths={[300, 600]} sizes="20vw" loading="eager" />

    </div>
    </div>
  </div>
  <div class="topo-fundo" aria-hidden="true"></div>
  <!-- topo à direita, alinhado ao "sobre": toggle de visualização (mesma altura do texto) + microinfo -->
  <div class="topo-dir">
    <p class="micro micro--dir" data-tx="micro">Criando por afeto e<br />conexões com o mundo</p>
    <div class="visao" data-visao role="radiogroup" aria-label="Alterar visualização">
      <button type="button" role="radio" aria-checked="true" aria-label="Esfera" title="Esfera" data-modo="esfera">
        <Globe strokeWidth={1.8} />
      </button>
      <button type="button" role="radio" aria-checked="false" aria-label="Galeria" title="Galeria" data-modo="galeria">
        <LayoutGrid strokeWidth={1.8} />
      </button>
    </div>
  </div>
  <!-- modo de edição da galeria (só com /?editar): reordenar as capas arrastando -->
  <div class="editor" data-editor>
    <span class="editor__titulo">Editar ordem</span>
    <div class="editor__seg" role="radiogroup" aria-label="Ordem a editar">
      <button type="button" role="radio" aria-checked="true" data-ordem="web">Web</button>
      <button type="button" role="radio" aria-checked="false" data-ordem="mobile">Mobile</button>
    </div>
    <button type="button" class="editor__btn" data-editor-desfazer>Desfazer</button>
    <button type="button" class="editor__btn editor__btn--ok" data-editor-salvar>Salvar</button>
    <span class="editor__msg" data-editor-msg aria-live="polite"></span>
  </div>
  <!-- modo de edição das coisas do "sobre" no mobile (só com /?editar, em tela estreita) -->
  <div class="editor" data-editor-coisas>
    <span class="editor__titulo">Posições (mobile)</span>
    <button type="button" class="editor__btn" data-coisas-desfazer>Desfazer</button>
    <button type="button" class="editor__btn editor__btn--ok" data-coisas-salvar>Salvar</button>
    <span class="editor__msg" data-coisas-msg aria-live="polite"></span>
  </div>
  <!-- microinfos: topo da esfera, alinhadas ao logo (esquerda) e ao "sobre" (direita) -->
  <p class="micro micro--esq" data-tx="micro">Porto Alegre, Brasil<br />Disponível remotamente</p>
  <ContatoLinks class="contato-esf" />
  <p class="dica-scroll" aria-hidden="true">Scrolle para revelar <ArrowDown size={14} strokeWidth={1.8} /></p>
  <!-- informações do card sob o mouse: título (bold) à esquerda; função e link à direita -->
  <div class="info" data-info aria-live="polite">
    <strong class="info__titulo" data-info-titulo></strong>
    <span class="info__lado"><span data-info-funcao></span><a data-info-link href="#" target="_blank" rel="noopener">Ver post →</a></span>
  </div>
  <button type="button" class="pular" data-pular aria-label="Ir direto para a esfera">
    <ChevronsRight size={28} strokeWidth={1.6} />
  </button>
</Base>

<script>
  // crédito da seção de contato: no mobile (< 768px) leva ao site da Georgia; na web continua no LinkedIn
  const credito = document.querySelector<HTMLAnchorElement>('[data-credito]');
  if (credito) {
    const web = credito.href;
    const mq = matchMedia('(max-width: 767px)');
    const ajustar = () => (credito.href = mq.matches ? (credito.dataset.hrefMobile ?? web) : web);
    ajustar();
    mq.addEventListener('change', ajustar);
  }
</script>

<script>
  import '../scripts/experiencia.ts';
  import '../scripts/rotativa.ts';
  import '../scripts/editar-coisas.ts';
  import '../scripts/peel.ts';
  import '../scripts/cavalo.ts';
  import '../scripts/gifs-projetos.ts';
</script>

<style is:global>
  /* variáveis da estrela: registradas SEM herança e escritas direto em quem as usa (scripts/experiencia.ts).
     Escritas no .estrela (herdadas), elas invalidavam o estilo de toda a subárvore (centenas de elementos) a cada quadro da rolagem. */
  @property --estrela-w { syntax: '<length>'; inherits: false; initial-value: 0px; }
  @property --op { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --campo { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --gif { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --fundo-vivo {
    syntax: '<color>';
    inherits: true;
    initial-value: #f9ffe1;
  }
  @property --fg-vivo {
    syntax: '<color>';
    inherits: true;
    initial-value: #7f1616;
  }
  .camera {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 200%; /* viewport 1 (Juju) + viewport 2 (fila e esfera) */
    will-change: transform;
  }
  /* estrela de rolagem (mouse icon-10), offwhite: cresce com a rolagem até cobrir a tela toda.  k = unidade de tamanho do palco */
  .estrela {
    --k: min(1vh, 1.2vw);
    --t-base: clamp(22px, 2.7vw, 42px); /* corpo tipográfico de referência dos versos do gif */
    position: absolute;
    inset: 0;
    z-index: 5; /* acima da esfera, abaixo da navbar e dos botões */
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
    --estrela-w: 0px;
    --op: 0;
    --campo: 0;
    --gif: 0;
  }
  .estrela__mundo {
    position: absolute;
    inset: 0;
  }
  .estrela__forma {
    position: absolute;
    left: 50%;
    top: 50%;
    display: block;
    width: var(--estrela-w); /* vetor redimensionado por layout (não por transform): sempre nítido */
    height: auto;
    aspect-ratio: 225.45 / 230.41;
    fill: var(--color-off-white);
    opacity: var(--op);
    transform: translate(-50%, -50%);
  }
  /* garantia de cobertura total ao fim do crescimento */
  .estrela__campo {
    position: absolute;
    inset: 0;
    background: var(--color-off-white);
    opacity: var(--campo);
  }
  /* palco do GIF (quadro 3:4 com margem vazia: o selo ocupa ~58% da largura) + wordmark logo abaixo */
  .palco {
    position: absolute;
    left: 50%;
    top: calc(50% - 49.2 * var(--k));
    width: calc(63 * var(--k));
    height: calc(84 * var(--k));
    transform: translateX(-50%);
    opacity: var(--gif);
  }
  .palco__gif {
    position: relative;
    z-index: 1; /* acima das coisas: elas saem de trás do selo */
    display: block;
    width: 100%;
    height: 100%;
  }
  .palco__wordmark {
    position: absolute;
    z-index: 1;
    left: 52%;
    top: calc(80% + 21px);
    width: calc(45 * var(--k)); /* +25% */
    height: auto;
    transform: translateX(-50%);
  }
  /* área que reage ao pairar e ao clique: o selo */
  .palco__alvo {
    position: absolute;
    z-index: 3;
    left: 22%;
    top: 24%;
    width: 60%;
    height: 54%;
  }
  .estrela.is-gif .palco__alvo {
    pointer-events: auto;
  }
  /* coisas: nascem escondidas atrás do selo (cabeça), deslizam até o destino ao pairar e voltam ao parar */
  /* o prefixo sobe a especificidade acima de `.page img:not(...)` do global.css, que sobrescrevia a transição de volta */
  .estrela .palco .coisa {
    position: absolute;
    z-index: 0;
    left: 52%; /* cabeça dela */
    top: 40%;
    width: calc(var(--w) * var(--k));
    height: auto;
    opacity: 0;
    /* mesmas funções de transform do estado aberto (translate, rotate, scale): a interpolação é função a função, sem salto */
    transform: translate(-50%, -50%) rotate(var(--r)) scale(0.5);
    will-change: transform;
    /* volta: espelha a saída. Mesmo escalonamento (--d), curva suave nas duas pontas, 1,6s; some só no fim, já atrás do selo */
    transition:
      transform 1.6s cubic-bezier(0.45, 0.05, 0.25, 1) var(--d),
      opacity 0.5s ease-in-out calc(var(--d) + 1.1s);
  }
  .estrela .palco:has(.palco__alvo:hover) .coisa,
  .estrela .palco.is-aberto .coisa {
    opacity: 1;
    transform: translate(calc(-50% + var(--dx) * var(--k)), calc(-50% + var(--dy) * var(--k))) rotate(var(--r)) scale(1);
    transition:
      transform 1.1s var(--ease-soft) var(--d),
      opacity 0.2s linear var(--d);
  }
  /* mobile: as coisas já ficam fora do selo (sem o movimento de sair ao pairar), nas posições --dxm/--dym (editáveis em /?editar).
     Giro (--r) é o de antes; o tamanho é 62,5% do original. */
  @media (max-width: 767px) {
    .estrela .palco .coisa,
    .estrela .palco:has(.palco__alvo:hover) .coisa,
    .estrela .palco.is-aberto .coisa {
      width: calc(var(--w) * var(--k) * 0.625); /* 62,5% do tamanho original (50% + 25%) */
      opacity: 1;
      transform: translate(calc(-50% + var(--dxm) * var(--k)), calc(-50% + var(--dym) * var(--k))) rotate(var(--r)) scale(1);
      transition: none;
      z-index: 2; /* por cima do selo */
    }
    /* a área do selo (que reagia ao pairar) ficava por cima das imagens e as impedia de ser pegas: no mobile não faz mais nada */
    .palco__alvo {
      display: none;
    }
    /* coisas-10, coisas-11 e noite-embacada não existem no mobile */
    .estrela .palco .coisa.coisa--so-desktop {
      display: none;
    }
    /* o palco inteiro (e as coisas, como adesivos) fica acima dos versos */
    .estrela .palco {
      z-index: 2;
    }
    /* adesivos: dá para pegar e arrastar dentro da seção (scripts/editar-coisas.ts) */
    .estrela.is-gif .palco .coisa {
      pointer-events: auto;
      cursor: grab;
      touch-action: none;
      -webkit-user-drag: none;
      user-select: none;
    }
    .estrela.is-gif .palco .coisa:active {
      cursor: grabbing;
    }
  }
  /* sticker peeling (scripts/peel.ts): só no mobile; o overlay .peel-ov herda posição/giro do adesivo e desenha a aba dobrada */
  .peel-ov > * { display: none; }
  .peel-ov { pointer-events: none !important; }
  @media (max-width: 767px) {
    img[style*='--peel-mask'] {
      -webkit-mask-image: var(--peel-mask);
      mask-image: var(--peel-mask);
    }
    .peel-ov > * { display: block; }
    .peel__sombra { position: absolute; inset: 0; filter: drop-shadow(-2px -2px 3px rgba(0, 0, 0, 0.3)); }
    .peel__aba {
      position: absolute;
      inset: 0;
      transform-origin: 0 0;
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }
  }
  /* editor das posições (mobile, /?editar): cada coisa pode ser arrastada */
  html.is-editando .estrela.is-gif .palco .coisa,
  html.is-editando .estrela.is-gif .verso {
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    outline: 1px dashed rgb(13 12 12 / 60%);
    outline-offset: 2px;
  }
  /* sequência "sobre": segue o viewport do GIF, ainda sobre o bege. Manrope em tudo: tracking -0,04em, entrelinha 0,9.
     Alinhamento pela navbar: margem esquerda = logo, direita = "sobre" */
  /* cavalo: fundo da seção "trabalho com", em difference (contraste com a cor da vez); fica abaixo do texto */
  .cavalo__canvas,
  .cavalo__aurea {
    position: absolute;
    image-rendering: pixelated; /* células do dither nítidas */
    pointer-events: none;
  }
  .cavalo__canvas {
    z-index: 0;
    left: 50%;
    top: 50%;
    width: 80vw; /* o desenho ocupa ~70% da largura da tela */
    aspect-ratio: 640 / 440;
    transform: translate(-50%, -50%);
    mix-blend-mode: difference;
  }
  /* espiral áurea (guardada, sem uso no momento): em difference, 15% menor, centrada */
  .cavalo__aurea {
    inset: 7.5%;
    width: 85%;
    height: 85%;
    mix-blend-mode: difference;
  }
  /* pilha das seções que sobem depois do GIF: foto, depois "trabalho com" */
  .sobre-pilha {
    position: absolute;
    left: 0;
    top: 100%;
    width: 100%;
  }
  /* tamanho dos títulos das seções ("trabalho com", projetos): igual ao texto principal da seção de grids (web 48px de um quadro de 1440; mobile 22px de um quadro de 390) */
  :root { --tam-titulo: calc(100vw * 46 / 1440); }
  @media (max-width: 767px) {
    :root { --tam-titulo: calc(100vw * 22 / 390); }
  }
  /* diagramação definida na página /teste-grid.
     Web (quadro 1440×900): 12 colunas × 10 linhas, 24px de distância, margens 52 / 68.
     Mobile (quadro 390×1560): 5 colunas × 14 linhas, 12px de distância, margens 20 / 72; tudo escala com a largura (--m = 1px do quadro). */
  .foto-seq {
    --edge: var(--space-nav-edge);
    --mx: calc(var(--u) * var(--edge));
    --my: 68px;
    position: relative;
    width: 100%;
    height: max(100vh, 700px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(10, minmax(0, 1fr));
    gap: 24px;
    padding: var(--my) var(--mx);
    background: var(--color-off-white);
    font-family: var(--font-body);
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--color-red);
    pointer-events: auto;
  }
  .foto-seq .grao {
    --op-e: 0.28;
  }
  .foto-seq__fig {
    position: relative; /* acima do grão */
    margin: 0;
    overflow: hidden; /* os cantos arredondam pelo script, ligados à rolagem */
  }
  .foto-seq__fig img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* web */
  .foto-seq__fig--a { grid-column: 1 / 6; grid-row: 1 / -1; margin: calc(var(--my) * -1) 0 calc(var(--my) * -1) calc(var(--mx) * -1); } /* Foto 8323: sangra esquerda, topo e base */
  .foto-seq__fig--b { grid-column: 9 / 12; grid-row: 1 / 7; } /* Foto 8322 */
  .foto-seq__fig--c { grid-column: 6 / 9; grid-row: 5 / 11; } /* Foto sobre */
  .foto-seq__txt {
    position: relative;
    display: flex;
    align-items: center;
    grid-column: 6 / 9;
    grid-row: 1 / 5;
  }
  .foto-seq__txt--topo { grid-column: 12 / 13; grid-row: 1 / 3; align-items: flex-start; }
  .foto-seq__txt--base { grid-column: 9 / 13; grid-row: 7 / 11; align-items: flex-end; }
  .foto-seq__mini {
    margin: 0;
    font-size: calc(100vw * 20 / 1440);
    font-weight: var(--weight-semibold);
  }
  .foto-seq__texto--m { font-weight: var(--weight-medium); }
  .foto-seq__texto {
    width: 100%;
    margin: 0;
    font-size: var(--tam-titulo) !important; /* o script de ajuste não manda mais no tamanho */
    font-weight: var(--weight-semibold);
    line-height: 0.9;
  }
  .sobre-pilha .foto-seq__sticker {
    display: none; /* no web o adesivo não aparece */
    position: absolute;
    z-index: 3;
    height: auto;
  }
  @media (max-width: 767px) {
    .foto-seq {
      --m: calc(100vw / 390);
      --mx: calc(var(--m) * 20);
      --my: calc(var(--m) * 72);
      /* o quadro do editor tem 14 linhas, mas só as 8 primeiras têm conteúdo: a seção termina na linha 8 (+ a margem vertical de baixo) */
      height: calc(var(--m) * (72 + 8 * 90 + 7 * 12 + 72) - 48px);
      padding-bottom: calc(var(--my) - 48px); /* 48px a menos no final: a altura e o respiro de baixo diminuem juntos, então as linhas do grid não encolhem */
      grid-template-columns: repeat(5, minmax(0, 1fr));
      grid-template-rows: repeat(8, minmax(0, 1fr));
      gap: calc(var(--m) * 12);
    }
    .foto-seq__fig--a { grid-column: 1 / 4; grid-row: 1 / 5; margin: 0; } /* Foto 8323 */
    .foto-seq__fig--b { grid-column: 1 / 4; grid-row: 6 / 9; } /* Foto 8322 */
    .foto-seq__fig--c { grid-column: 4 / 6; grid-row: 3 / 7; } /* Foto sobre */
    .foto-seq__txt { grid-column: 4 / 6; grid-row: 1 / 3; min-height: 0; order: 0; } /* texto principal */
    .foto-seq__txt--topo { grid-column: 1 / 2; grid-row: 5 / 6; }
    .foto-seq__txt--base { grid-column: 4 / 6; grid-row: 7 / 9; }
    .foto-seq .so-web { display: none; } /* as quebras de linha do texto de baixo são só do web */
    .foto-seq .foto-seq__texto { font-size: calc(var(--m) * 22) !important; }
    .foto-seq .foto-seq__texto--m { font-size: calc(var(--m) * 20) !important; }
    .foto-seq .foto-seq__mini { font-size: calc(var(--m) * 14); font-weight: var(--weight-medium); }
    /* adesivo (x 42,7% / y 28% / largura 24% do quadro 390×1560 da primeira seção); arrastável por toda a pilha do sobre */
    .sobre-pilha { --m: calc(100vw / 390); }
    .sobre-pilha .foto-seq__sticker {
      display: block;
      pointer-events: auto; /* o pai (.estrela) tem pointer-events: none */
      left: 42.7%;
      top: calc(var(--m) * 1560 * 0.28);
      width: 24%;
      transform: rotate(-14deg);
      cursor: grab;
      touch-action: none;
      user-select: none;
      -webkit-user-drag: none;
    }
  }
  /* ---------- contatos fixos (esfera/galeria): alinhados ao texto de cima, azul em difference ---------- */
  .contato-esf {
    position: fixed;
    z-index: var(--z-fixed);
    left: calc(var(--u) * var(--space-nav-edge));
    bottom: calc(24px + env(safe-area-inset-bottom)); /* iOS: acima do indicador de início quando a barra do Safari recolhe */
    color: var(--color-light-blue);
    mix-blend-mode: difference;
    transition: opacity var(--duration-modal) var(--ease-soft);
  }
  @media (max-width: 767px) {
    .contato-esf { left: calc(var(--u) * var(--space-nav-edge-mobile)); }
  }
  /* web, rodapé da galeria: duas linhas — WhatsApp, Instagram / Email, Linkedin (colunas alinhadas, sem bolinhas) */
  @media (min-width: 768px) {
    .contato-links.contato-esf {
      display: grid;
      grid-template-columns: auto auto;
      justify-content: start;
      align-items: center;
      column-gap: 28px;
      row-gap: 12px;
    }
    .contato-links.contato-esf .contato-links__linha { display: contents; }
    .contato-links.contato-esf .contato-links__ponto { display: none; }
    .contato-links.contato-esf .contato-links__a--whats { grid-area: 1 / 1; justify-self: start; }
    .contato-links.contato-esf .contato-links__a--insta { grid-area: 1 / 2; }
    .contato-links.contato-esf .contato-links__a--email { grid-area: 2 / 1; justify-self: start; }
    .contato-links.contato-esf .contato-links__a--linkedin { grid-area: 2 / 2; }
  }
  .dica-scroll {
    position: fixed;
    z-index: var(--z-fixed);
    right: calc(var(--u) * var(--space-nav-edge));
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--color-light-blue);
    mix-blend-mode: difference;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: var(--weight-medium);
    letter-spacing: -0.04em;
    line-height: 0.9;
    pointer-events: none;
    transition: opacity var(--duration-modal) var(--ease-soft);
  }
  @media (max-width: 767px) {
    .dica-scroll { right: calc(var(--u) * var(--space-nav-edge-mobile)); }
  }
  body.is-intro .dica-scroll,
  body.is-estrela .dica-scroll,
  body.is-intro .contato-esf,
  body.is-estrela .contato-esf {
    opacity: 0;
    pointer-events: none;
  }
  /* ---------- rodapé: offwhite, Juju vermelha, contatos no canto inferior direito ---------- */
  .rod-seq {
    --mx: calc(var(--u) * var(--space-nav-edge));
    position: relative;
    width: 100%;
    height: max(100vh, 560px);
    background: var(--rod-bg, var(--color-off-white));
    color: var(--rod-fg, var(--color-red));
    font-family: var(--font-body);
    letter-spacing: -0.04em;
    line-height: 0.9;
    overflow: hidden;
    pointer-events: auto;
  }
  .rod-seq { z-index: 1; }
  .rod-seq .grao { --op-e: 0.28; }
  .rod-seq__tit {
    z-index: 1;
    position: absolute;
    left: var(--mx);
    top: calc(var(--h-nav-atual) + 4px);
    margin: 0;
    font-size: calc(clamp(44px, 9.6vw, 170px) * 0.56 - 4px); /* web: 4px menor (o mobile redefine abaixo) */
    font-weight: var(--weight-semibold);
  }
  .rod-seq__juju {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    width: clamp(276px, 46vw, 690px); /* mesmo tamanho da Juju da tela de abertura */
    height: auto;
    transform: translate(-50%, -50%);
  }
  /* contatos espalhados em volta da Juju: Instagram à esquerda, Linkedin à direita, o email embaixo */
  .rod-seq__credito { position: absolute; right: 10px; bottom: 10px; z-index: 2; display: inline-flex; align-items: center; gap: 0.4em; color: var(--color-black); font-size: clamp(11px, 0.95vw, 14px); font-weight: var(--weight-medium); text-transform: uppercase; }
  .rod-seq__credito:hover { opacity: 1; }
  .rod-seq__credito span { position: relative; }
  .rod-seq__credito span::after { content: ''; position: absolute; left: 0; right: 0; bottom: -0.1em; height: max(1px, 0.07em); background: currentColor; transform: scaleX(0); transform-origin: left center; transition: transform 0.35s var(--ease-soft); }
  .rod-seq__credito:hover span::after { transform: scaleX(1); }
  .rod-seq__contato { position: absolute; inset: 0; z-index: 1; pointer-events: none; font-size: calc(clamp(44px, 9.6vw, 170px) * 0.21); line-height: 0.9; }
  .rod-seq__contato .contato-links__linha:first-child { display: contents; }
  .rod-seq__contato .contato-links__ponto { display: none; }
  .rod-seq__contato a,
  .rod-seq__contato .contato-links__linha:last-child { position: absolute; margin: 0; transform: translate(-50%, -50%); white-space: nowrap; pointer-events: auto; }
  /* posição-base de cada bullet; o ajuste fino fica em --*-dx / --*-dy (px absolutos: + direita, + baixo), aplicado com a propriedade `translate` (não colide com o `transform` do hover/rotação) */
  .rod-seq__contato {
    --insta-dx: -15px;  --insta-dy: 0px;
    --linkedin-dx: 5px; --linkedin-dy: 5px;
    --whats-dx: 0px;    --whats-dy: 87px;   /* web: +82px em relação ao mobile */
    --email-dx: 0px;    --email-dy: -14px;  /* web: +84px em relação ao mobile */
  }
  .rod-seq__contato .contato-links__a--insta { left: calc(25% + 3px); top: calc(47% + 7px); translate: var(--insta-dx) var(--insta-dy); }
  .rod-seq__contato .contato-links__a--linkedin { left: 75%; top: 43%; translate: var(--linkedin-dx) var(--linkedin-dy); }
  .rod-seq__contato .contato-links__linha:last-child { left: 50%; top: calc(74% + 80px); translate: var(--email-dx) var(--email-dy); }
  /* contatos como bullets inclinados, iguais aos da seção de rotação (mesmo tamanho e peso) */
  .rod-seq__contato { font-size: clamp(11px, 0.95vw, 14px); }
  .rod-seq__contato .contato-links__a { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.55em 1em 0.5em; border: 1px solid currentColor; border-radius: 999px; font-weight: var(--weight-bold); text-transform: uppercase; transform: translate(-50%, -50%) rotate(var(--rot, 0deg)); transition: transform var(--duration-fast) var(--ease-soft); }
  .rod-seq__contato .contato-links__a::after { display: none; }
  .rod-seq__contato .contato-links__a:hover { transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) translateY(-2px) scale(1.04); }
  .rod-seq__contato .contato-links__a svg { flex: none; width: 1em; height: 1em; }
  .rod-seq__contato .contato-links__linha:last-child { transform: translate(-50%, -50%); }
  .rod-seq__contato .contato-links__linha:last-child .contato-links__a { position: static; transform: rotate(var(--rot, 0deg)); }
  .rod-seq__contato .contato-links__linha:last-child .contato-links__a:hover { transform: rotate(var(--rot, 0deg)) translateY(-2px) scale(1.04); }
  /* WhatsApp (web e mobile): em cima da Juju, 15px acima da cabeça dela (altura da Juju = 0,7727 × a largura), inclinado como os outros */
  .contato-links.rod-seq__contato .contato-links__linha--whats { display: block; position: absolute; inset: 0; margin: 0; pointer-events: none; }
  .rod-seq__contato .contato-links__linha--whats .contato-links__a {
    display: inline-flex;
    left: 50%;
    top: calc(50% - clamp(276px, 46vw, 690px) * 0.7727 / 2 - 15px);
    translate: var(--whats-dx) var(--whats-dy);
    transform: translate(-50%, -100%) rotate(var(--rot, 0deg));
  }
  .rod-seq__contato .contato-links__linha--whats .contato-links__a:hover {
    transform: translate(-50%, -100%) rotate(var(--rot, 0deg)) translateY(-2px) scale(1.04);
  }
  .rod-seq .so-mobile { display: none; }
  /* web: tipografia dos bullets em 16px, medium */
  @media (min-width: 768px) {
    .rod-seq__contato { font-size: 16px; }
    .rod-seq__contato .contato-links__a { font-weight: var(--weight-medium); }
  }
  @media (max-width: 767px) {
    .rod-seq { --mx: calc(var(--u) * var(--space-nav-edge-mobile)); height: 100vh; height: 100svh; } /* mobile: exatamente a altura da tela visível (sem o mínimo de 560px; svh desconta as barras do navegador) */
    .rod-seq .so-mobile { display: inline; }
    /* mobile: WhatsApp e email mais acima que na web */
    .rod-seq__contato { --whats-dy: 5px; --email-dy: -114px; --linkedin-dy: 15px; }
    .rod-seq__contato .contato-links__a { font-weight: var(--weight-semibold); }
    /* título: 20px, bold, em duas linhas, 20px mais para baixo */
    .rod-seq__tit { top: calc(var(--h-nav-atual) + 4px + 20px); font-size: calc(var(--tam-titulo) + 9px); font-weight: var(--weight-bold); }
    /* galeria (esfera e lista): no rodapé fixo fica só o WhatsApp */
    .contato-links.contato-esf .contato-links__linha:not(.contato-links__linha--whats) { display: none; }
    .contato-links.contato-esf .contato-links__linha--whats { display: flex; }
  }
  /* ---------- seção dos projetos: fundo vermelho, texto azul ---------- */
  .proj-seq {
    --mx: calc(var(--u) * var(--space-nav-edge));
    --t-mini: clamp(14px, 1.5vw, 22px); /* o "trabalho com" e o texto pequeno da seção de grids */
    position: relative;
    width: 100%;
    min-height: 100vh;
    padding: calc(var(--h-nav-atual) + 4px + 2.4 * var(--t-mini)) var(--mx) 72px;
    background: var(--color-off-white); /* fixo: não acompanha a cor da seção anterior */
    color: var(--color-black);
    font-family: var(--font-body);
    letter-spacing: -0.04em;
    line-height: 0.9;
    pointer-events: auto;
  }
  .proj {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: end; /* textos alinhados à base da imagem */
    padding-bottom: 72px;
  }
  .proj + .proj { padding-top: 24px; }
  .proj__txt { position: relative; grid-column: 1 / 6; align-self: end; }
  .proj__titulo {
    margin: 0;
    color: var(--color-red);
    font-size: var(--tam-titulo, clamp(28px, 3vw, 44px)); /* igual ao texto principal da seção de grids (definido por script) */
    font-weight: var(--weight-semibold);
  }
  .proj__legenda {
    margin: 14px 0 18px;
    font-size: calc(var(--t-mini) - 2px);
    font-weight: var(--weight-medium);
  }
  .proj__desc { font-size: var(--t-mini); font-weight: var(--weight-medium); line-height: 0.95; }
  .proj__desc, .proj__desc p { font-weight: var(--weight-medium); }
  .proj__desc p { margin: 0 0 12px; }
  .proj__behance { display: inline-flex; align-items: center; gap: 0.25em; margin-top: 6px; font-size: 12px; font-weight: var(--weight-medium); color: var(--color-black); }
  .proj__behance:hover { opacity: 1; }
  .proj__behance span { position: relative; }
  .proj__behance span::after { content: ''; position: absolute; left: 0; right: 0; bottom: -0.1em; height: max(1px, 0.05em); background: currentColor; transform: scaleX(0); transform-origin: left center; transition: transform 0.35s var(--ease-soft); }
  .proj__behance:hover span::after { transform: scaleX(1); }
  .proj__img { display: block; position: relative; overflow: hidden; grid-column: 7 / 13; aspect-ratio: 425 / 237; background: color-mix(in srgb, var(--color-light-blue) 10%, transparent); }
  .proj__img img { width: 100%; height: 100%; object-fit: cover; }
  .proj__img:has(.proj__pend) { border: 1px solid currentColor; } /* placeholder de capa: stroke fina */
  .proj__pend { display: grid; place-content: center; height: 100%; text-align: center; font-weight: var(--weight-medium); }
  .proj__pend small { font-size: 0.55em; opacity: 0.7; }
  @media (max-width: 767px) {
    .proj-seq { --mx: calc(var(--u) * var(--space-nav-edge-mobile)); padding-bottom: 12px; } /* 72px − 60px */
    .proj__txt, .proj__img { grid-column: 1 / -1; }
    .proj__img { margin-top: 16px; } /* bloco de texto 8px mais perto da capa */
    .proj__legenda { font-weight: var(--weight-semibold); }
  }
  .sobre-seq {
    --edge: var(--space-nav-edge);
    position: relative;
