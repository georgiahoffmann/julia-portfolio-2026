    transition: opacity var(--duration-modal) var(--ease-soft);
  }
  @media (max-width: 767px) {
    .dica-scroll { right: calc(var(--u) * var(--space-nav-edge-mobile)); }
  }
  body.is-intro .dica-scroll,
  body.is-estrela .dica-scroll,
  body.is-intro .contato-esf,
  body.is-estrela .contato-esf {
    opacity: 0;
    pointer-events: none;
  }
  /* ---------- rodapé: offwhite, Juju vermelha, contatos no canto inferior direito ---------- */
  .rod-seq {
    --mx: calc(var(--u) * var(--space-nav-edge));
    position: relative;
    width: 100%;
    height: max(100vh, 560px);
    background: var(--rod-bg, var(--color-off-white));
    color: var(--rod-fg, var(--color-red));
    font-family: var(--font-body);
    letter-spacing: -0.04em;
    line-height: 0.9;
    overflow: hidden;
    pointer-events: auto;
  }
  .rod-seq { z-index: 1; }
  .rod-seq .grao { --op-e: 0.28; }
  .rod-seq__tit {
    z-index: 1;
    position: absolute;
    left: var(--mx);
    top: calc(var(--h-nav-atual) + 4px);
    margin: 0;
    font-size: calc(clamp(44px, 9.6vw, 170px) * 0.56);
    font-weight: var(--weight-semibold);
  }
  .rod-seq__juju {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    width: clamp(276px, 46vw, 690px); /* mesmo tamanho da Juju da tela de abertura */
    height: auto;
    transform: translate(-50%, -50%);
  }
  /* contatos espalhados em volta da Juju: Instagram à esquerda, Linkedin à direita, o email embaixo */
  .rod-seq__credito { position: absolute; right: 10px; bottom: 10px; z-index: 2; display: inline-flex; align-items: center; gap: 0.4em; color: var(--color-black); font-size: clamp(11px, 0.95vw, 14px); font-weight: var(--weight-medium); text-transform: uppercase; }
  .rod-seq__credito:hover { opacity: 1; }
  .rod-seq__credito span { position: relative; }
  .rod-seq__credito span::after { content: ''; position: absolute; left: 0; right: 0; bottom: -0.1em; height: max(1px, 0.07em); background: currentColor; transform: scaleX(0); transform-origin: left center; transition: transform 0.35s var(--ease-soft); }
  .rod-seq__credito:hover span::after { transform: scaleX(1); }
  .rod-seq__contato { position: absolute; inset: 0; z-index: 1; pointer-events: none; font-size: calc(clamp(44px, 9.6vw, 170px) * 0.21); line-height: 0.9; }
  .rod-seq__contato .contato-links__linha:first-child { display: contents; }
  .rod-seq__contato .contato-links__ponto { display: none; }
  .rod-seq__contato a,
  .rod-seq__contato .contato-links__linha:last-child { position: absolute; margin: 0; transform: translate(-50%, -50%); white-space: nowrap; pointer-events: auto; }
  .rod-seq__contato a:nth-of-type(1) { left: calc(25% + 3px); top: calc(47% + 7px); }
  .rod-seq__contato a:nth-of-type(2) { left: 75%; top: 43%; }
  .rod-seq__contato .contato-links__linha:last-child { left: 50%; top: calc(74% + 80px); }
  /* contatos como bullets inclinados, iguais aos da seção de rotação (mesmo tamanho e peso) */
  .rod-seq__contato { font-size: clamp(11px, 0.95vw, 14px); }
  .rod-seq__contato .contato-links__a { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.55em 1em 0.5em; border: 1px solid currentColor; border-radius: 999px; font-weight: var(--weight-bold); text-transform: uppercase; transform: translate(-50%, -50%) rotate(var(--rot, 0deg)); transition: transform var(--duration-fast) var(--ease-soft); }
  .rod-seq__contato .contato-links__a::after { display: none; }
  .rod-seq__contato .contato-links__a:hover { transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) translateY(-2px) scale(1.04); }
  .rod-seq__contato .contato-links__a svg { flex: none; width: 1em; height: 1em; }
  .rod-seq__contato .contato-links__linha:last-child { transform: translate(-50%, -50%); }
  .rod-seq__contato .contato-links__linha:last-child .contato-links__a { position: static; transform: rotate(var(--rot, 0deg)); }
  .rod-seq__contato .contato-links__linha:last-child .contato-links__a:hover { transform: rotate(var(--rot, 0deg)) translateY(-2px) scale(1.04); }
  @media (max-width: 767px) {
    .rod-seq { --mx: calc(var(--u) * var(--space-nav-edge-mobile)); }
  }
  /* ---------- seção dos projetos: fundo vermelho, texto azul ---------- */
  .proj-seq {
    --mx: calc(var(--u) * var(--space-nav-edge));
    --t-mini: clamp(14px, 1.5vw, 22px); /* o "trabalho com" e o texto pequeno da seção de grids */
    position: relative;
    width: 100%;
    min-height: 100vh;
    padding: calc(var(--h-nav-atual) + 4px + 2.4 * var(--t-mini)) var(--mx) 72px;
    background: var(--color-off-white); /* fixo: não acompanha a cor da seção anterior */
    color: var(--color-black);
    font-family: var(--font-body);
    letter-spacing: -0.04em;
    line-height: 0.9;
    pointer-events: auto;
  }
  .proj {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: end; /* textos alinhados à base da imagem */
    padding-bottom: 72px;
  }
  .proj + .proj { padding-top: 24px; }
  .proj__txt { position: relative; grid-column: 1 / 6; align-self: end; }
  .proj__titulo {
    margin: 0;
    color: var(--color-red);
    font-size: var(--tam-titulo, clamp(28px, 3vw, 44px)); /* igual ao texto principal da seção de grids (definido por script) */
    font-weight: var(--weight-semibold);
  }
  .proj__legenda {
    margin: 14px 0 18px;
    font-size: calc(var(--t-mini) - 2px);
    font-weight: var(--weight-medium);
  }
  .proj__desc { font-size: var(--t-mini); font-weight: var(--weight-medium); line-height: 0.95; }
  .proj__desc, .proj__desc p { font-weight: var(--weight-medium); }
  .proj__desc p { margin: 0 0 12px; }
  .proj__behance { display: inline-flex; align-items: center; gap: 0.25em; margin-top: 6px; font-size: 12px; font-weight: var(--weight-medium); color: var(--color-black); }
  .proj__behance:hover { opacity: 1; }
  .proj__behance span { position: relative; }
  .proj__behance span::after { content: ''; position: absolute; left: 0; right: 0; bottom: -0.1em; height: max(1px, 0.05em); background: currentColor; transform: scaleX(0); transform-origin: left center; transition: transform 0.35s var(--ease-soft); }
  .proj__behance:hover span::after { transform: scaleX(1); }
  .proj__img { display: block; position: relative; overflow: hidden; grid-column: 7 / 13; aspect-ratio: 425 / 237; background: color-mix(in srgb, var(--color-light-blue) 10%, transparent); }
  .proj__img img { width: 100%; height: 100%; object-fit: cover; }
  .proj__img:has(.proj__pend) { border: 1px solid currentColor; } /* placeholder de capa: stroke fina */
  .proj__pend { display: grid; place-content: center; height: 100%; text-align: center; font-weight: var(--weight-medium); }
  .proj__pend small { font-size: 0.55em; opacity: 0.7; }
  @media (max-width: 767px) {
    .proj-seq { --mx: calc(var(--u) * var(--space-nav-edge-mobile)); }
    .proj__txt, .proj__img { grid-column: 1 / -1; }
    .proj__img { margin-top: 24px; }
  }
  .sobre-seq {
    --edge: var(--space-nav-edge);
    position: relative;
    width: 100%;
    min-height: 100vh;
    padding: var(--h-nav-atual) calc(var(--u) * var(--edge));
    display: flex;
    flex-direction: column;
    justify-content: center; /* bloco de texto centralizado na vertical, alinhado à esquerda (margem do logo) */
    --fundo-vivo: var(--color-off-white); /* ao entrar é offwhite; a cor da vez surge aos poucos com a seção à vista */
    --fg-vivo: var(--color-red);
    background: var(--fundo-vivo);
    color: var(--fg-vivo);
    /* fundo e texto: calculados a cada quadro em experiencia.ts (paleta da palavra da vez + rolagem) */
    pointer-events: auto;
    font-family: var(--font-body);
    letter-spacing: -0.04em;
    line-height: 0.9;
  }
  .sobre-seq .grao {
    --op-e: 0.28;
    --op-c: 0;
  }
  .sobre-seq.is-pronta[data-fundo='claro'] .grao {
    --op-e: 0;
    --op-c: 0.28;
  }
  .hero {
    position: relative; /* acima do grão */
    text-align: left;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .pilulas {
    margin-top: 42px !important; /* 42px abaixo do texto que rotaciona */
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* cada bullet tem um fundo da cor da seção (bloqueia o cavalo atrás); borda e texto ficam em difference sobre esse fundo */
  .pilula {
    position: relative;
    display: inline-flex;
    padding: 0.55em 1em 0.5em;
    border-radius: 999px;
    background: var(--fundo-vivo);
    font-size: clamp(11px, 0.95vw, 14px);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    transform: rotate(var(--rot)); /* leve giro fixo, como colado à mão */
    transition: transform var(--duration-fast) var(--ease-soft);
  }
  .pilula::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-off-white);
    border-radius: inherit;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .pilula span {
    position: relative;
    color: var(--color-off-white);
    mix-blend-mode: difference;
  }
  .pilula:hover {
    transform: rotate(var(--rot)) translateY(-2px) scale(1.04);
  }
  /* "aberta a freelas": preenchida com o inverso do fundo; o texto recorta na cor do fundo */
  .pilula--destaque::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-off-white);
    mix-blend-mode: difference;
  }
  .pilula--destaque span {
    mix-blend-mode: normal;
    color: var(--fundo-vivo);
  }
  .hero__trabalho {
    margin: clamp(20px, 2.4vw, 36px) 0 0;
    font-size: clamp(14px, 1.5vw, 22px);
    font-weight: var(--weight-medium);
  }
  /* palavra em rotação: os 4 itens empilhados na mesma célula reservam a largura do maior e a altura da linha (2 linhas se quebrar) */
  .rotativa {
    margin-top: 6px;
    font-size: 9.6vw; /* o maior possível: "Identidade Visual" ocupa quase toda a largura útil */
    font-weight: var(--weight-semibold);
    line-height: 0.95;
    outline-offset: 6px;
  }
  .rotativa__itens {
    display: grid;
  }
  .rotativa__item {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.3em);
    transition:
      opacity 0.35s var(--ease-soft),
      transform 0.35s var(--ease-soft);
  }
  .rotativa__item.is-ativa {
    opacity: 1;
    transform: none;
  }
  .rotativa__item.is-saindo {
    transform: translateY(-0.3em);
  }
  @media (max-width: 767px) {
    .sobre-seq {
      --edge: var(--space-nav-edge-mobile);
      padding-bottom: 48px;
    }
    .rotativa {
      font-size: 15vw;
    }
    .pilulas {
      margin-top: 42px !important;
    }
  }
  /* Text Appear: letras entram em sequência (translateY + opacidade + blur); a pressão (peso) é feita em scripts/tipografia.ts */
  .tx .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .tx { word-spacing: 0.12em; } /* o tracking negativo comia o espaço entre as palavras */
  .tx .palavra {
    display: inline-block;
    white-space: nowrap;
  }
  /* durante a medição das letras (tipografia.ts) elas ficam sem transform/transição */
  .tx-medindo .tx .letra {
    transform: none !important;
    transition: none !important;
    filter: none !important;
  }
  .tx .letra {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.45em);
    filter: blur(6px);
    transition:
      opacity 0.25s var(--ease-soft),
      transform 0.25s var(--ease-soft),
      filter 0.25s var(--ease-soft);
  }
  .tx.is-visivel .letra {
    opacity: 1;
    transform: none;
    filter: none;
    transition:
      opacity 0.8s var(--ease-soft) calc(var(--i) * var(--passo) + var(--atraso, 0ms)),
      transform 0.9s var(--ease-soft) calc(var(--i) * var(--passo) + var(--atraso, 0ms)),
      filter 0.8s var(--ease-soft) calc(var(--i) * var(--passo) + var(--atraso, 0ms));
  }
  @media (prefers-reduced-motion: reduce) {
    .tx .letra,
    .tx.is-visivel .letra {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
  /* versos nos cantos, alinhados pela navbar: esquerda = logo, direita = "sobre" */
  .verso {
    --logo-w: var(--w-nav-logo);
    position: absolute;
    margin: 0;
    max-width: 9.5em;
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--t-base);
    line-height: 0.9;
    letter-spacing: -0.04em; /* tracking -40 */
    color: var(--color-red);
    opacity: var(--gif);
  }
  .verso--topo {
    left: calc(var(--u) * var(--space-nav-edge));
    /* 24px abaixo do logo (centrado na navbar; altura do logo = 0,7727 × largura) */
    top: calc(var(--h-nav-atual) / 2 + var(--u) * var(--logo-w) * 0.7727 / 2 + 24px);
    text-align: left;
  }
  .verso--base {
    right: calc(var(--u) * var(--space-nav-edge));
    bottom: calc(var(--u) * var(--space-nav-edge));
    text-align: right;
  }
  @media (max-width: 767px) {
    .verso {
      --logo-w: var(--w-nav-logo-mobile);
    }
    .verso--topo {
      left: calc(var(--u) * var(--space-nav-edge-mobile));
    }
    .verso--base {
      right: calc(var(--u) * var(--space-nav-edge-mobile));
      bottom: calc(var(--u) * var(--space-nav-edge-mobile));
    }
  }
  /* Juju: centralizada no viewport 1 */
  .juju {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 50%;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .juju__img {
    grid-area: 1 / 1;
    width: clamp(276px, 46vw, 690px); /* 15% maior que antes */
    height: auto;
  }
  @media (max-width: 767px) {
    .juju__img {
      width: 85vw;
    }
  }
  /* o link do card expandido precisa contrastar com o fundo vermelho da esfera */
  body:has([data-esfera]) {
    --color-modal-link: var(--color-off-white);
  }
  /* navbar: some durante a abertura e entra de leve na esfera */
  .nav {
    transition:
      opacity var(--duration-modal) var(--ease-soft),
      transform var(--duration-modal) var(--ease-soft);
  }
  body.is-intro .nav {
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
  }
  /* topo à direita: toggle + microinfo, com a mesma altura; o conjunto termina na margem do "sobre" */
  .topo-dir {
    position: fixed;
    z-index: var(--z-fixed);
    top: calc(var(--h-nav-atual) + 4px);
    right: calc(var(--u) * var(--space-nav-edge));
    display: flex;
    align-items: center;
    gap: 16px;
    transition: opacity var(--duration-modal) var(--ease-soft);
  }
  @media (max-width: 767px) {
    .topo-dir {
      right: calc(var(--u) * var(--space-nav-edge-mobile));
    }
  }
  body.is-intro .topo-dir,
  body.is-estrela .topo-dir {
    opacity: 0;
    pointer-events: none;
  }
  /* toggle só de ícones, sem fundo, traço offwhite, em difference */
  .visao {
    --h-toggle: calc(12px * 0.9 * 2 * 1.27 * 1.2); /* altura do bloco de texto (2 linhas de 12px, entrelinha 0,9) + 27% + 20% */
    display: inline-flex;
    flex: none;
    box-sizing: border-box;
    height: var(--h-toggle);
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--color-off-white);
    border-radius: 999px;
    mix-blend-mode: difference;
  }
  .visao button {
    display: grid;
    place-items: center;
    flex: none;
    width: calc(var(--h-toggle) - 6px); /* 2px de padding + 1px de borda de cada lado */
    height: calc(var(--h-toggle) - 6px);
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    color: var(--color-off-white);
    opacity: 0.55;
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  .visao button svg {
    width: 60%;
    height: 60%;
  }
  .visao button:hover {
    opacity: 0.85;
  }
  .visao button[aria-checked='true'] {
    opacity: 1;
    border-color: var(--color-off-white);
  }
  .visao button:focus-visible {
    outline: 1px solid var(--color-off-white);
    outline-offset: 2px;
  }
  /* seta dupla: leva direto para a esfera */
  .pular {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: var(--z-fixed);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-red);
    transition: opacity var(--duration-base) var(--ease-soft);
  }
  .pular:hover {
    opacity: var(--opacity-hover);
  }
  body:not(.is-intro) .pular {
    opacity: 0;
    pointer-events: none;
  }
  .micro,
  .info {
    position: fixed;
    z-index: var(--z-fixed);
    margin: 0;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--weight-medium);
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--color-off-white);
    transition: opacity var(--duration-modal) var(--ease-soft);
  }
  .micro {
    font-size: 14px; /* +2px */
    top: calc(var(--h-nav-atual) + 4px);
    pointer-events: none;
  }
  .micro--esq {
    left: calc(var(--u) * var(--space-nav-edge));
  }
  .topo-dir .micro {
    position: static;
    text-align: right;
    align-self: center;
  }
  .info {
    left: calc(var(--u) * var(--space-nav-edge)); /* título: alinhado ao logo */
    right: calc(var(--u) * var(--space-nav-edge)); /* descrição e link: alinhados ao "sobre" */
    top: 50%; /* altura do centro do viewport, onde fica o mouse ao pairar */
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-size: 16px;
    mix-blend-mode: difference; /* sempre em contraste com o que passa por baixo */
    opacity: 0;
    pointer-events: none;
  }
  .info.is-visivel {
    opacity: 1;
  }
  /* na galeria: mesma posição, mas com um quadro vermelho de 2px abraçando cada texto */
  .info.info--gal {
    mix-blend-mode: normal;
    color: var(--color-red);
  }
  .info.info--gal .tx { word-spacing: 0; }
  .info.info--gal .info__titulo,
  .info.info--gal .info__lado > span:not(:empty),
  .info.info--gal .info__lado > a:not([hidden]) {
    background: var(--color-light-blue);
    padding: 2px;
    width: fit-content;
    height: fit-content;
    max-width: max-content;
  }
  /* com o card aberto, o texto permanece e fica acima do modal */
  html.is-modal-open .info {
    z-index: calc(var(--z-modal) + 1);
